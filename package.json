{
  "name": "perch-player",
  "productName": "Perch",
  "version": "0.1.4",
  "description": "A floating video player for macOS, with familiar controls and a queue.",
  "main": "src/main.cjs",
  "author": "Leo Zhou <zhouleo2007@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild src/preload.js --bundle --platform=node --external:electron --outfile=dist/preload.cjs --loader:.css=text",
    "start": "npm run build && electron .",
    "test": "node --test tests/unit.test.cjs",
    "verify": "npm run build && node scripts/verify.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dist": "npm run build && node scripts/package.mjs --zip",
    "package:test": "npm run build && node scripts/package.mjs --test",
    "format": "prettier --write \"src/**/*.{js,cjs,html,css}\" \"scripts/*.mjs\" \"tests/*.cjs\" package.json .prettierrc.json .github/workflows/ci.yml",
    "format:check": "prettier --check \"src/**/*.{js,cjs,html,css}\" \"scripts/*.mjs\" \"tests/*.cjs\" package.json .prettierrc.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
